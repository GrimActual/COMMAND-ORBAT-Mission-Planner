{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://77th-jsoc.example/schemas/tracked-batch-v3",
  "title": "Opt-in tracked telemetry batch v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "token",
    "sequence",
    "full",
    "activeIds",
    "entities"
  ],
  "properties": {
    "protocol": {
      "const": 3
    },
    "token": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "full": {
      "type": "boolean"
    },
    "activeIds": {
      "type": "array",
      "maxItems": 60,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "entities": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "x",
          "z"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "x": {
            "type": "number",
            "minimum": -13500,
            "maximum": 13500
          },
          "z": {
            "type": "number",
            "minimum": -13500,
            "maximum": 13500
          }
        }
      }
    }
  }
}
